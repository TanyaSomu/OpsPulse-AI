# OpsPulse AI Environment Configuration

# Core Application
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="OpsPulse AI"
API_V1_STR=/api/v1

# Security
SECRET_KEY=opspulse_ai_dev_jwt_secret_key_9923847192384791823749812739481
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
# Local development on Windows uses port 5433 by default; in Docker it uses postgres:5432
DATABASE_URL=postgresql://postgres@localhost:5432/opspulse

# Background Processing & Redis
REDIS_URL=redis://localhost:6379/0

# Operational SLA Settings
DEFAULT_ACK_TIMEOUT_SECONDS=300
ALERT_CORRELATION_WINDOW_MINUTES=15
ESCALATION_CHECK_INTERVAL_SECONDS=10

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
